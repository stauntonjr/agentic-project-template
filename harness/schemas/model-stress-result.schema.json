{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-project-template/model-stress-result.schema.json",
  "title": "Sanitized paired model-stress result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "evidence_level", "accepted_baseline", "model_invoked", "provenance", "task", "limits", "trial_count", "lanes", "comparison"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "authority": {"const": "supplemental"},
    "evidence_level": {"enum": ["smoke", "acceptance-candidate"]},
    "accepted_baseline": {"const": false},
    "model_invoked": {"const": true},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "provider", "pi_version", "serving_runtime", "serving_recipe", "endpoint_class"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 512},
        "provider": {"type": "string", "minLength": 1, "maxLength": 512},
        "pi_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 512},
        "serving_runtime": {"type": "string", "minLength": 1, "maxLength": 512},
        "serving_recipe": {"type": "string", "minLength": 1, "maxLength": 512},
        "endpoint_class": {"const": "local-loopback-openai-compatible"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "task_class", "task_digest", "prompt_digest", "tool_set", "oracle_case_count", "oracle_case_ids", "resource_bundle_digest", "writable_paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
        "task_class": {"enum": ["implementation", "defect-repair", "cross-file-integration"]},
        "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_set": {"const": ["read", "edit"]},
        "oracle_case_count": {"type": "integer", "minimum": 1, "maximum": 70},
        "oracle_case_ids": {
          "type": "array", "minItems": 1, "maxItems": 70, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80}
        },
        "resource_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "writable_paths": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"const": "identifier-canonicalization-v1"}}, "required": ["id"]},
          "then": {"properties": {"task_class": {"const": "implementation"}}}
        },
        {
          "if": {"properties": {"id": {"const": "retry-after-repair-v1"}}, "required": ["id"]},
          "then": {"properties": {"task_class": {"const": "defect-repair"}}}
        },
        {
          "if": {"properties": {"id": {"const": "release-policy-integration-v1"}}, "required": ["id"]},
          "then": {"properties": {"task_class": {"const": "cross-file-integration"}}}
        }
      ]
    },
    "limits": {"$ref": "#/$defs/limits"},
    "trial_count": {"type": "integer", "minimum": 1, "maximum": 10, "not": {"const": 2}},
    "lanes": {
      "type": "object", "additionalProperties": false, "required": ["bare", "harness"],
      "properties": {"bare": {"$ref": "#/$defs/lane"}, "harness": {"$ref": "#/$defs/lane"}}
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["bare_passed_trials", "harness_passed_trials", "observed_pass_difference", "general_harness_lift_claim"],
      "properties": {
        "bare_passed_trials": {"type": "integer", "minimum": 0},
        "harness_passed_trials": {"type": "integer", "minimum": 0},
        "observed_pass_difference": {"type": "integer"},
        "general_harness_lift_claim": {"const": false}
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["model_timeout_seconds", "oracle_timeout_seconds", "maximum_event_bytes", "maximum_changed_files", "maximum_output_tokens"],
      "properties": {
        "model_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 900},
        "oracle_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "maximum_event_bytes": {"type": "integer", "minimum": 65536, "maximum": 8388608},
        "maximum_changed_files": {"type": "integer", "minimum": 1, "maximum": 5},
        "maximum_output_tokens": {"const": 4096}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false, "required": ["passed_trials", "total_trials", "trials"],
      "properties": {
        "passed_trials": {"type": "integer", "minimum": 0},
        "total_trials": {"type": "integer", "minimum": 1, "maximum": 10},
        "trials": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/trial"}}
      }
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["returncode", "settled", "timed_out", "event_limit_ok", "elapsed_seconds", "changed_paths", "scope_result", "tool_errors", "usage", "trial", "test_result"],
      "properties": {
        "returncode": {"type": "integer"},
        "settled": {"type": "boolean"},
        "timed_out": {"type": "boolean"},
        "event_limit_ok": {"type": "boolean"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope_result": {
          "type": "object", "additionalProperties": false, "required": ["ok", "allowed_paths"],
          "properties": {
            "ok": {"type": "boolean"},
            "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "tool_errors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["tool", "category", "count"],
            "properties": {
              "tool": {"enum": ["read", "edit", "unavailable"]},
              "category": {"const": "tool-execution-error"},
              "count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "usage": {
          "type": "object", "additionalProperties": false,
          "required": ["measurement_origin", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"],
          "properties": {
            "measurement_origin": {"enum": ["provider-reported", "unavailable"]},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}
          },
          "allOf": [
            {
              "if": {"properties": {"measurement_origin": {"const": "unavailable"}}},
              "then": {"properties": {"input_tokens": {"const": null}, "output_tokens": {"const": null}, "cache_read_tokens": {"const": null}, "cache_write_tokens": {"const": null}}}
            },
            {
              "if": {"properties": {"measurement_origin": {"const": "provider-reported"}}},
              "then": {"properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cache_read_tokens": {"type": "integer", "minimum": 0}, "cache_write_tokens": {"type": "integer", "minimum": 0}}}
            }
          ]
        },
        "trial": {"type": "integer", "minimum": 1, "maximum": 10},
        "test_result": {
          "type": "object", "additionalProperties": false,
          "required": ["ok", "passed", "failed_case_ids", "elapsed_seconds", "timed_out"],
          "properties": {
            "ok": {"type": "boolean"},
            "passed": {"type": "integer", "minimum": 0},
            "failed_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
            "elapsed_seconds": {"type": "number", "minimum": 0},
            "timed_out": {"type": "boolean"}
          }
        }
      }
    }
  }
}
